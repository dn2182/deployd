# /etc/systemd/system/deployd.service
#
# Installed by deploy/install-ubuntu.sh, which also creates the identity:
#   useradd --system --user-group --home-dir /opt/deployd --shell /usr/sbin/nologin deployd
#   /opt/deployd     repo clone, .venv, .node, .env (root:deployd 0640)
#   /var/lib/deployd apps.yaml, secrets.env, deployd.sqlite3, backups/
#   /srv/deployd     managed release directories
#   systemctl enable --now deployd
#
# Restart commands in apps.yaml usually need systemctl on OTHER services;
# grant the deployd user a narrow sudoers rule per app, e.g.:
#   deployd ALL=(root) NOPASSWD: /usr/bin/systemctl restart example-api
# and use ["sudo", "systemctl", "restart", "example-api"] in apps.yaml.
#
# Expose 8300 only via the reverse proxy / Cloudflare; never directly.

[Unit]
Description=deployd deploy agent
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=deployd
Group=deployd
WorkingDirectory=/opt/deployd
EnvironmentFile=/opt/deployd/.env
ExecStart=/opt/deployd/.venv/bin/deployd
Restart=on-failure
RestartSec=3
# The service pings the watchdog every 15 s; systemd restarts it after a missed minute.
WatchdogSec=60
# On stop only deployd gets SIGTERM; in-flight migrate/restart/hook children keep
# running until the drain finishes, then everything left is killed at the timeout.
# Keep this above DEPLOYD_DRAIN_TIMEOUT_SECONDS plus the largest command timeout.
KillMode=mixed
TimeoutStopSec=660
# Restart via sudo requires narrow sudoers rules; otherwise enable NoNewPrivileges.
NoNewPrivileges=no
# sudo children inherit this bounding set, so restart helpers cannot gain capabilities outside it.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE CAP_KILL
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# ProtectSystem=full keeps /var/www writable for the root website helper.
ProtectSystem=full
ReadOnlyPaths=/opt/deployd
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
LogRateLimitIntervalSec=30
LogRateLimitBurst=1000

[Install]
WantedBy=multi-user.target
