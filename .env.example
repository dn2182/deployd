# Ubuntu service paths; the installer creates these files and their permissions.
DEPLOYD_DB_PATH=/var/lib/deployd/deployd.sqlite3
DEPLOYD_APPS_CONFIG=/var/lib/deployd/apps.yaml
DEPLOYD_SECRETS_FILE=/var/lib/deployd/secrets.env
# Local development: use deployd.sqlite3, config/apps.yaml, config/secrets.env instead.
DEPLOYD_BIND_HOST=127.0.0.1
DEPLOYD_BIND_PORT=8300
DEPLOYD_MAX_REQUEST_BYTES=65536

# Installer generates a secure random token when empty and preserves existing tokens.
# Without the installer, empty disables /admin. Generate a token for local development:
# python3 -c "import secrets; print(secrets.token_hex(32))"
DEPLOYD_ADMIN_TOKEN=

# Optional fallback for private GitHub release downloads; prefer per-app tokens in the UI.
# Use a fine-grained token with
# Contents: read on only the required repositories. Never put this token in apps.yaml.
DEPLOYD_GITHUB_TOKEN=

# Per-app HMAC secrets and GitHub tokens are configured via the admin UI/API and
# stored in DEPLOYD_SECRETS_FILE. To pin a secret
# by hand instead, set DEPLOYD_SECRET_<APP_NAME_UPPER_SNAKE>; env always
# wins over the secrets file.

# Finished deployments older than this leave the history (steps included) during
# hourly maintenance. Nonces are purged after 24 hours regardless.
DEPLOYD_HISTORY_KEEP_DAYS=90
# On shutdown, in-flight migrations and cutovers get this long to finish before
# the process exits; keep systemd's TimeoutStopSec above it.
DEPLOYD_DRAIN_TIMEOUT_SECONDS=600
