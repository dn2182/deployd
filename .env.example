# deployd runtime settings — copy to .env and fill in
DEPLOYD_DB_PATH=deployd.sqlite3
DEPLOYD_APPS_CONFIG=config/apps.yaml
DEPLOYD_BIND_HOST=127.0.0.1
DEPLOYD_BIND_PORT=8300
DEPLOYD_MAX_REQUEST_BYTES=65536

# Admin API/UI auth — unset disables /admin entirely
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
DEPLOYD_ADMIN_TOKEN=

# Per-app HMAC secrets are created via the admin UI/API (rotate-secret) and
# stored in config/secrets.env — nothing to configure here. To pin a secret
# by hand instead, set DEPLOYD_SECRET_<APP_NAME_UPPER_SNAKE>; env always
# wins over the secrets file.
